<div style="-webkit-print-color-adjust:exact;width:100%;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:7.5pt;color:#94a3b8;padding:0 {{.MarginRightMM}}mm 0 {{.MarginLeftMM}}mm;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:12pt;border-bottom:0.5pt solid #e2e8f0;padding-bottom:3pt;">
    <span style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{{.Title}}</span>
    <span style="flex:none;">{{.Version}}</span>
  </div>
</div>
