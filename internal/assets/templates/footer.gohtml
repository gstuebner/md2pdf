<div style="-webkit-print-color-adjust:exact;width:100%;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:7.5pt;color:#94a3b8;padding:0 {{.MarginRightMM}}mm 0 {{.MarginLeftMM}}mm;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12pt;border-top:0.5pt solid #e2e8f0;padding-top:3pt;">
    <span style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{{.Footer}}</span>
    <span style="flex:none;">{{.PageWord}} <span class="pageNumber"></span> {{.OfWord}} <span class="totalPages"></span></span>
  </div>
</div>
